# Local development defaults. Do not use the local server as a public deployment.
SHIRO_HOST=127.0.0.1
SHIRO_PORT=8001
# SHIRO_DB=C:/path/to/shiro.sqlite3
# Optional NVIDIA NIM key. Add to ignored .env or Vercel environment; never commit it.
# SHIRO pins its provider to the free NVIDIA endpoint: google/gemma-4-31b-it.
# NVIDIA_API_KEY=

# Hosted Vercel only. Configure all three values; hosted mode fails closed if any are absent.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Use the Supabase transaction pooler connection URI for serverless traffic.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
